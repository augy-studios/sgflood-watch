# Telegram bot token from @BotFather (see SETUP.md)
BOT_TOKEN=

# LTA DataMall AccountKey — request one free at https://datamall.lta.gov.sg/content/datamall/en/request-for-api.html
LTA_ACCOUNT_KEY=

# Path to the SQLite database file (created automatically on first run)
DB_PATH=./data/bot.db

# How often (in seconds) the bot polls LTA for new/changed flood alerts to
# broadcast to /sub subscribers. Persisted into the SQLite schedule table on
# first boot; edit the DB row afterwards if you want to change it without
# touching this file (see README.md).
POLL_INTERVAL_SECONDS=180

# URL for the "Open Web App" button on /start
WEBAPP_URL=https://sgflood.uwuapps.org

# URL for the "Support the project" button on /start
DONATE_URL=https://donate.stripe.com/28o2akeAr3hv0DK6oo
